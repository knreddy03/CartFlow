APP_NAME=CartFlow

# Set to True for local development, False for production
DEBUG=True

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-database-password>
POSTGRES_DB=cartflow_db

DATABASE_URL=postgresql://postgres:<your-database-password>@db:5432/cartflow_db
TEST_DATABASE_URL=postgresql://postgres:<your-database-password>@db:5432/cartflow_test

# Local development example
FRONTEND_URL=http://localhost:5173

SECRET_KEY=<generate-a-secure-secret>
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=10